{
  "server_url": "http://127.0.0.1:8099",
  "server_token": "changeme",
  "poll_interval_sec": 10,
  "state_path": "/data/bridge_state.json",
  "allow_apps": [
    "Docker",
    "SAN Manager",
    "UGREEN AI",
    "存储管理",
